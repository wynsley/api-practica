// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  idUser       String   @id @default(cuid())
  fullname     String   @db.VarChar(100)
  email        String   @unique @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  nickname     String   @db.VarChar(20)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects UserProject[]
}

enum status {
  TODO
  DOING
  DONE
}

model Project {
  idProject String    @id @default(cuid())
  name      String    @db.VarChar(100)
  category  String    @db.VarChar(50)
  startDate DateTime
  endDate   DateTime?
  state     status
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users UserProject[]
}

enum Role {
  LEADER
  WORKER
}

model UserProject {
  idUser     String
  idProject  String
  role       Role
  assignedAt DateTime @default(now())

  user    User    @relation(fields: [idUser], references: [idUser], onDelete: Cascade)
  project Project @relation(fields: [idProject], references: [idProject], onDelete: Cascade)

  @@id([idUser, idProject])
}
